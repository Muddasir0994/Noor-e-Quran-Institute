rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    // Public read collections (Catalog, Directory, Reviews)
    // Anyone can read courses, packages, tutors, testimonials, articles, resources
    // Only authenticated users can write (admin/teachers manage via portal)
    match /courses/{courseId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /packages/{packageId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /tutors/{tutorId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /testimonials/{testimonialId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /articles/{articleId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /resources/{resourceId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Site SEO configs (admin "SEO & Meta Tags" panel). Public read so the
    // live site can apply them; writes require an authenticated admin.
    match /siteSeo/{pageId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Inbound Leads & Applications from parents (Create publicly, manage requires auth)
    match /leads/{leadId} {
      allow create: if true;
      allow read, update, delete: if isAuthenticated();
    }

    match /enrollments/{enrollmentId} {
      allow create: if true;
      allow read, update, delete: if isAuthenticated();
    }

    match /contactMessages/{messageId} {
      allow create: if true;
      allow read, update, delete: if isAuthenticated();
    }

    // Portal Collections (Students, Teachers, Users & Class Progress)
    // All operations require authentication
    match /users/{userId} {
      allow read, write: if isAuthenticated();
    }

    match /students/{studentId} {
      allow read, write: if isAuthenticated();
    }

    match /progressReports/{reportId} {
      allow read, write: if isAuthenticated();
    }

    match /scheduledClasses/{classId} {
      allow read, write: if isAuthenticated();
    }

    match /assessments/{assessmentId} {
      allow read, write: if isAuthenticated();
    }

    // Default catch-all: deny everything not explicitly matched above
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
